{
  "name": "u8-mqtt",
  "description": "MQTT client using Uint8Array -- suitable for use in the Browser, NodeJS, and Deno.land.",
  "version": "0.6.7",
  "license": "BSD-2-Clause",
  "author": "Shane Holloway <shane.holloway@ieee.org>",
  "homepage": "https://github.com/shanewholloway/js-u8-mqtt#readme",
  "bugs": {
    "url": "https://github.com/shanewholloway/js-u8-mqtt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shanewholloway/js-u8-mqtt.git"
  },
  "files": [
    "cjs/",
    "code/",
    "esm/",
    "types/"
  ],
  "type": "module",
  "main": "./cjs/index.cjs",
  "module": "./esm/index.js",
  "browser": "./esm/web/index.min.js",
  "types": "./types/index.d.ts",
  "exports": {
    "./esm/index.js": {
      "types": "./types/index.d.ts",
      "default": "./esm/index.js"
    },
    "./esm/web/index.js": {
      "types": "./types/index.d.ts",
      "default": "./esm/web/index.js"
    },
    "./esm/node/index.js": {
      "types": "./types/index.d.ts",
      "default": "./esm/node/index.js"
    },
    "./esm/deno/index.js": {
      "types": "./types/index.d.ts",
      "default": "./esm/deno/index.js"
    },
    "./esm/*.js": {
      "types": "./types/*.d.ts",
      "default": "./esm/*.js"
    },
    "./esm/web/*.js": {
      "types": "./types/*.d.ts",
      "default": "./esm/web/*.js"
    },
    "./esm/web/*.min.js": {
      "types": "./types/*.d.ts",
      "default": "./esm/web/*.min.js"
    },
    "./esm/node/*.js": {
      "types": "./types/*.d.ts",
      "default": "./esm/node/*.js"
    },
    "./esm/node/*.mjs": {
      "types": "./types/*.d.ts",
      "default": "./esm/node/*.mjs"
    },
    "./esm/deno/*.js": {
      "types": "./types/*.d.ts",
      "default": "./esm/deno/*.js"
    },
    "./esm/*": "./esm/*",
    "./cjs/index.cjs": {
      "types": "./types/index.d.ts",
      "default": "./cjs/index.cjs"
    },
    "./cjs/*.cjs": {
      "types": "./types/*.d.ts",
      "default": "./cjs/*.cjs"
    },
    "./cjs/*": "./cjs/*",
    "./types/*": "./types/*",
    "./web": {
      "types": "./types/index.d.ts",
      "default": "./esm/web/index.js"
    },
    "./deno": {
      "types": "./types/index.d.ts",
      "default": "./esm/deno/index.js"
    },
    "./node": {
      "types": "./types/index.d.ts",
      "default": "./esm/node/index.js"
    },
    "./core": {
      "types": "./types/index.d.ts",
      "default": "./esm/index.js"
    },
    ".": {
      "types": "./types/index.d.ts",
      "browser": "./esm/web/index.js",
      "deno": "./esm/deno/index.js",
      "require": "./cjs/index.cjs",
      "node": "./esm/node/index.js",
      "import": "./esm/index.js",
      "default": "./esm/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "types/*": ["./types/*"],
      "web": ["./types/index.d.ts"],
      "deno": ["./types/index.d.ts"],
      "node": ["./types/index.d.ts"],
      "core": ["./types/index.d.ts"],
      "esm/index.js": ["./types/index.d.ts"],
      "esm/*/index.js": ["./types/index.d.ts"],
      "esm/*/index.min.js": ["./types/index.d.ts"],
      "esm/v4.js": ["./types/v4.d.ts"],
      "esm/*/v4.js": ["./types/v4.d.ts"],
      "esm/*/v4.min.js": ["./types/v4.d.ts"],
      "esm/v5.js": ["./types/v5.d.ts"],
      "esm/*/v5.js": ["./types/v5.d.ts"],
      "esm/*/v5.min.js": ["./types/v5.d.ts"],
      "esm/basic-v4.js": ["./types/basic-v4.d.ts"],
      "esm/*/basic-v4.js": ["./types/basic-v4.d.ts"],
      "esm/*/basic-v4.min.js": ["./types/basic-v4.d.ts"],
      "esm/basic-v5.js": ["./types/basic-v5.d.ts"],
      "esm/*/basic-v5.js": ["./types/basic-v5.d.ts"],
      "esm/*/basic-v5.min.js": ["./types/basic-v5.d.ts"],
      "esm/full-v4.js": ["./types/full-v4.d.ts"],
      "esm/*/full-v4.js": ["./types/full-v4.d.ts"],
      "esm/*/full-v4.min.js": ["./types/full-v4.d.ts"],
      "esm/full-v5.js": ["./types/full-v5.d.ts"],
      "esm/*/full-v5.js": ["./types/full-v5.d.ts"],
      "esm/*/full-v5.min.js": ["./types/full-v5.d.ts"],
      "cjs/index.cjs": ["./types/index.d.ts"],
      "cjs/v4.cjs": ["./types/v4.d.ts"],
      "cjs/v5.cjs": ["./types/v5.d.ts"],
      "cjs/basic-v4.cjs": ["./types/basic-v4.d.ts"],
      "cjs/basic-v5.cjs": ["./types/basic-v5.d.ts"],
      "cjs/full-v4.cjs": ["./types/full-v4.d.ts"],
      "cjs/full-v5.cjs": ["./types/full-v5.d.ts"],
      "*": ["./types/index.d.ts"]
    }
  },
  "workspaces": [
    "demo"
  ],
  "devDependencies": {
    "@jsy-lang/jsy": "^0.10.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-virtual": "^3.0.2",
    "regexparam": "^3.0.0",
    "rollup": "^4.54.0",
    "u8-mqtt-packet": "^0.4.1",
    "vite": "^7.3.0"
  },
  "scripts": {
    "vite": "vite",
    "serve": "vite",
    "clean": "rm -rf ./cjs/* ./esm/*",
    "prebuild": "test -d ./node_modules || npm -s ci",
    "build": "rollup --config",
    "watch": "rollup --config --watch",
    "precompress": "rm -rf esm/web/* ; npm -s run build",
    "compress": "gzip -k esm/web/*.min.js ; brotli esm/web/*.min.js",
    "postcompress": "node ./_util/doc_compressed.js docs/compressed.md",
    "dkr_deps": "docker stack deploy -c test/integ/deps-deploy.yml integ_mqtt",
    "demo:node_v4": "node ./demo/node_v4.js",
    "demo:node_v5": "node ./demo/node_v5.js",
    "demo:deno_v4": "deno run --allow-net --allow-env=U8_MQTT ./demo/deno_v4.js",
    "demo:deno_v5": "deno run --allow-net --allow-env=U8_MQTT ./demo/deno_v5.js",
    "socat:ws:mosquitto_v16": "socat -dd tcp-listen:6880,reuseaddr,fork tcp:localhost:9880",
    "socat:tcp:mosquitto_v16": "socat -dd tcp-listen:6883,reuseaddr,fork tcp:localhost:9883",
    "socat:ws:mosquitto_v20": "socat -dd tcp-listen:6880,reuseaddr,fork tcp:localhost:9890",
    "socat:tcp:mosquitto_v20": "socat -dd tcp-listen:6883,reuseaddr,fork tcp:localhost:9893",
    "socat:ws:ejabberd": "socat -dd tcp-listen:6880,reuseaddr,fork tcp:localhost:5880",
    "socat:tcp:ejabberd": "socat -dd tcp-listen:6883,reuseaddr,fork tcp:localhost:5883",
    "pretest": "test -f esm/index.js || npm -s run build",
    "test": "true",
    "prepublishOnly": "npm -s run compress && npm -s run test"
  }
}
